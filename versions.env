# Single source of truth for pinned versions.
# Sourced by common.sh and scripts/install-tools.sh.
# Every variable can be overridden via the environment EXCEPT
# MINIKUBE_PROFILE — lab scripts hardcode the 'cka-labs' profile/node names.

# --- Cluster -------------------------------------------------------------
: "${KUBERNETES_VERSION:=v1.34.11}"   # newest v1.34 patch offered by minikube v1.39.0
: "${MINIKUBE_PROFILE:=cka-labs}"
: "${MINIKUBE_CPUS:=2}"
# 4GiB throttles hard under lab load (cgroup memory.max stalls -> liveness
# kills of ingress-nginx); 8GiB keeps a 3-node run comfortable.
# Default auto-sizes to half the host RAM, clamped to [4096, 8192] MiB —
# export MINIKUBE_MEMORY to override.
_auto_memory() {
    local half=$(( $1 / 2 ))
    (( half > 8192 )) && half=8192
    (( half < 4096 )) && half=4096
    printf '%s\n' "$half"
}
if [[ -z "${MINIKUBE_MEMORY:-}" ]]; then
    # half of host MiB; 16384 (=> 8192) when /proc/meminfo is unreadable
    _mem_total="$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || true)"
    : "${MINIKUBE_MEMORY:=$(_auto_memory "${_mem_total:-16384}")}"
fi
unset -f _auto_memory; unset _mem_total
: "${MINIKUBE_CNI:=calico}"           # default CNI does not enforce NetworkPolicy
: "${MINIKUBE_RUNTIME:=containerd}"
# MINIKUBE_DRIVER is intentionally unset: setup-minikube.sh auto-detects
# (docker, then podman). Export it to force a driver.

# --- Host tools (installed by scripts/install-tools.sh) -------------------
# Helm 3 matches the exam environment; export HELM_VERSION=v4.x.y to opt in to Helm 4.
: "${HELM_VERSION:=v3.22.0}"          # helm/helm      released 2026-09-10
: "${KUSTOMIZE_VERSION:=v5.8.2}"      # kustomize      released 2026-09-30
: "${ETCD_VERSION:=v3.6.15}"          # etcd-io/etcd   released 2026-09-22 (etcdctl+etcdutl)

# --- Third-party add-ons used by later labs -------------------------------
: "${PODINFO_CHART_VERSION:=6.15.0}" # stefanprodan/podinfo helm chart  released 2026-08-31
: "${GATEWAY_API_VERSION:=v1.6.2}"    # informational: lab 08 installs the CRDs bundled in the NGF kustomization
: "${NGF_VERSION:=v2.7.2}"            # nginx/nginx-gateway-fabric        released 2026-09-16
: "${CERT_MANAGER_VERSION:=v1.21.2}"  # cert-manager/cert-manager         released 2026-09-11
