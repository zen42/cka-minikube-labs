SHELL := /usr/bin/env bash
.DEFAULT_GOAL := help
.RECIPEPREFIX = >

export PATH := $(HOME)/.local/bin:$(PATH)

# labs/NN-slug dirs, sorted
LAB_DIRS := $(sort $(wildcard labs/[0-9][0-9]-*))

# resolve labs/$*-* -> dir (empty if no match)
lab_dir = $(firstword $(wildcard labs/$(1)-*))

.PHONY: help prereqs tools setup stop start reset-cluster clean-all progress test-all
.PHONY: lab-% verify-% solve-% teardown-% test-%

help:
> @echo "CKA minikube lab suite"
> @echo
> @echo "Cluster:"
> @echo "  make prereqs          check host tools (scripts/check-prereqs.sh)"
> @echo "  make tools            install pinned kubectl/helm/kustomize/etcdctl"
> @echo "  make setup            create/verify the cka-labs minikube cluster"
> @echo "  make stop|start       stop or resume the cka-labs cluster"
> @echo "  make reset-cluster    delete and recreate the cka-labs cluster"
> @echo
> @echo "Labs (NN = lab number, e.g. make lab-02):"
> @echo "  make lab-NN           check env + set up lab NN, then read its README"
> @echo "  make solve-NN         run the reference solution (non-interactive)"
> @echo "  make verify-NN        check whether lab NN tasks are complete"
> @echo "  make teardown-NN      remove lab NN resources"
> @echo "  make test-NN          check-env -> setup -> solve -> verify -> teardown"
> @echo "  make test-all         run test-NN for every lab"
> @echo "  make progress         regenerate PROGRESS.md from .progress/ markers"
> @echo "  make clean-all        teardown all labs + delete cka-lab namespaces"
> @echo
> @echo "Available labs:"
> @for d in $(LAB_DIRS); do echo "  $$d"; done

prereqs:
> ./scripts/check-prereqs.sh

tools:
> ./scripts/install-tools.sh

setup:
> ./setup-minikube.sh

stop:
> minikube -p cka-labs stop

start:
> minikube -p cka-labs start

reset-cluster:
> minikube -p cka-labs delete
> ./setup-minikube.sh

lab-%:
> @dir="$$(ls -d labs/$*-* 2>/dev/null | head -1)"; \
> if [[ -z "$$dir" ]]; then echo "no lab matching labs/$*-*"; exit 1; fi; \
> "$$dir/check-env.sh" && "$$dir/setup.sh" \
>   && echo && echo "Ready. Now read $$dir/README.md"

verify-%:
> @dir="$$(ls -d labs/$*-* 2>/dev/null | head -1)"; \
> if [[ -z "$$dir" ]]; then echo "no lab matching labs/$*-*"; exit 1; fi; \
> "$$dir/verify.sh"

solve-%:
> @dir="$$(ls -d labs/$*-* 2>/dev/null | head -1)"; \
> if [[ -z "$$dir" ]]; then echo "no lab matching labs/$*-*"; exit 1; fi; \
> "$$dir/solve.sh"

teardown-%:
> @dir="$$(ls -d labs/$*-* 2>/dev/null | head -1)"; \
> if [[ -z "$$dir" ]]; then echo "no lab matching labs/$*-*"; exit 1; fi; \
> "$$dir/teardown.sh"

test-%:
> @dir="$$(ls -d labs/$*-* 2>/dev/null | head -1)"; \
> if [[ -z "$$dir" ]]; then echo "no lab matching labs/$*-*"; exit 1; fi; \
> id="$*"; ok=1; \
> for step in check-env setup solve verify teardown; do \
>   echo "===== $$dir/$$step.sh ====="; \
>   "$$dir/$$step.sh" || { ok=0; break; }; \
> done; \
> if (( ok )); then echo "TEST $$id PASSED"; else echo "TEST $$id FAILED"; exit 1; fi

test-all:
> @declare -a results=(); \
> for dir in $(LAB_DIRS); do \
>   id="$${dir:5:2}"; \
>   if $(MAKE) --no-print-directory "test-$$id"; then \
>     results+=("$$id PASS"); else results+=("$$id FAIL"); fi; \
> done; \
> echo; echo "=== test-all summary ==="; \
> for r in "$${results[@]}"; do echo "  lab $$r"; done; \
> for r in "$${results[@]}"; do [[ "$$r" == *FAIL ]] && exit 1; done; true

progress:
> @{ \
>   echo "# Progress"; echo; \
>   echo "Generated by \`make progress\` — $$(date -Iseconds)"; echo; \
>   echo "| Lab | Title | Status | Completed at |"; \
>   echo "|-----|-------|--------|--------------|"; \
>   for d in $(LAB_DIRS); do \
>     id="$${d:5:2}"; \
>     title=$$(sed -n 's/^# Lab [0-9]* [–-] //p' "$$d/README.md" | head -1); \
>     if [[ -f ".progress/$$id" ]]; then \
>       echo "| $$id | $$title | done | $$(cat .progress/$$id) |"; \
>     else \
>       echo "| $$id | $$title | not started | — |"; \
>     fi; \
>   done; \
> } > PROGRESS.md
> @cat PROGRESS.md

clean-all:
> @for d in $(LAB_DIRS); do \
>   echo "=== teardown $$d ==="; \
>   "$$d/teardown.sh" || echo "  (teardown $$d failed — continuing)"; \
> done
> kubectl --context cka-labs delete ns -l cka-lab --ignore-not-found || true
